function deviceAssetName() {
	let m = trim2(shell('uname -m').out);
	let arch = '';
	if (m == 'aarch64' || m == 'arm64')
		arch = 'arm64';
	else if (m == 'armv7l' || m == 'armv7' || m == 'armv6l' || m == 'arm')
		arch = 'arm';
	else if (m == 'x86_64' || m == 'amd64')
		arch = 'amd64';
	else if (m == 'mipsle')
		arch = 'mipsle';
	return { arch: m, asset: arch != '' ? `wol-linux-${arch}` : null };
}

function installedVersion() {
	let bi = binaryInfo();
	return bi.version;
}

function validVersion(v) {
	return match(v ?? '', /^[0-9A-Za-z][0-9A-Za-z._-]{0,39}$/) != null;
}

function validDigest(d) {
	return match(d ?? '', /^[0-9a-f]{64}$/) != null;
}

function validUpdateUrl(u) {
	return match(u ?? '', /^https:\/\/github\.com\/inxen\/wolservice\/releases\/download\/[0-9A-Za-z._\/-]+$/) != null;
}

function verParts(v) {
	let m = match(v ?? '', /^v?([0-9]+)\.([0-9]+)\.([0-9]+)/);
	return m ? [ +m[1], +m[2], +m[3] ] : null;
}

function verGreater(a, b) {
	let pa = verParts(a), pb = verParts(b);
	if (!pa || !pb)
		return null;
	for (let i = 0; i < 3; i++)
		if (pa[i] != pb[i])
			return pa[i] > pb[i];
	return false;
}

function jobState() {
	let st = null;
	if (exists(JOB_STATUS)) {
		try { st = json(trim2(readfile(JOB_STATUS) ?? '')); } catch (e) { st = null; }
	}
	let phase = st ? (st.phase ?? 'idle') : 'idle';
	let total = st ? +(st.total ?? 0) : 0;
	let bytes = 0;
	if (phase == 'downloading') {
		let file = (st && type(st.file) == 'string' && match(st.file, /^\/tmp\/wolservice\.download\.[0-9A-Za-z.]+$/) != null) ? st.file : JOB_DOWNLOAD;
		let b = fsize(file);
		bytes = b > 0 ? b : 0;
	}
	else if (phase == 'verifying' || phase == 'installing' || phase == 'done') {
		bytes = total;
	}
	return {
		phase: phase,
		message: st ? (st.message ?? '') : '',
		total: total,
		bytes: bytes
	};
}

function jobActive() {
	let j = jobState();
	return j.phase == 'starting' || j.phase == 'downloading' ||
		j.phase == 'verifying' || j.phase == 'installing';
}

