	saveConfigForm: {
		args: { fields: '', restart: false },
		call: function(request) {
			let f = null;
			try { f = json(`${request.args.fields ?? ''}`); } catch (e) { f = null; }
			if (type(f) != 'object')
				return fail('表单数据格式无效');
			let c = conf();
			let cp = c.config_path;
			let ex = exists(cp);
			let text = '';
			if (ex) {
				try { text = readfile(cp) ?? ''; } catch (e) { return fail('读取配置文件失败：' + e); }
			}
			if (hasLegacySecrets(text))
				return fail('主配置含明文凭据；请先启动服务完成迁移，或使用服务自带 /config 保存');
			let built = buildGlobalConfig(text, f, ex);
			if (built.ok === false)
				return built;
			let r = writeConfigChecked(cp, built.content, truthy(request.args.restart));
			if (r.ok === false)
				return r;
			r.form = true;
			return r;
		}
	},

	probePanel: {
		call: function() {
			let c = conf();
			let cc = checkConfig(c.config_path);
			if (!cc.exists)
				return fail('配置文件不存在');
			let st = serviceState();
			if (!st.running)
				return fail('服务未运行');
			return panelProbe(cc);
		}
	},

	checkUpdate: {
		call: function() {
			let ai = deviceAssetName();
			let result = {
				ok: false,
				installed: installedVersion(),
				latest: null,
				has_update: null,
				published: null,
				size: null,
				digest: null,
				url: null,
				asset: ai.asset,
				arch: ai.arch,
				error: null
			};
			if (!ai.asset) {
				result.error = `当前架构 ${ai.arch} 没有预编译资产`;
				return result;
			}

			let r = httpGet(GH_API, false, 20);
			if (r.rc != 0 || trim2(r.out) == '') {
				result.error = '获取 GitHub Release 失败：' + (trim2(r.out) || '网络请求失败（可能是 GitHub API 限流或网络受限）');
				return result;
			}
			let rel = null;
			try { rel = json(trim2(r.out)); } catch (e) { rel = null; }
			if (rel == null) {
				result.error = 'GitHub API 响应解析失败';
				return result;
			}
			if (!rel.tag_name) {
				result.error = rel.message ?? 'GitHub API 返回异常（可能触发频率限制）';
				return result;
			}
			result.latest = rel.tag_name;
			result.published = rel.published_at ?? null;

			let asset = null;
			if (rel.assets) {
				for (let i = 0; i < length(rel.assets); i++)
					if (rel.assets[i].name == ai.asset)
						asset = rel.assets[i];
			}
			if (asset == null) {
				result.error = `Release ${rel.tag_name} 未找到 ${ai.asset} 资产`;
				return result;
			}
			result.size = asset.size ?? null;
			result.url = asset.browser_download_url ?? null;
			if (asset.digest != null && match(`${asset.digest}`, /^sha256:[0-9a-f]{64}$/))
				result.digest = replace(`${asset.digest}`, /^sha256:/, '');
			let cmp = result.installed ? verGreater(result.latest, result.installed) : true;
			result.has_update = cmp === null ? true : cmp;
			result.ok = true;
			return result;
		}
	},

	startInstall: {
		args: { version: '', url: '', digest: '', size: 0, asset: '' },
		call: function(request) {
			let version = `${request.args.version ?? ''}`;
			let url = `${request.args.url ?? ''}`;
			let digest = `${request.args.digest ?? ''}`;
			let size = +request.args.size;
			let asset = `${request.args.asset ?? ''}`;
			let ai = deviceAssetName();

			if (!validVersion(version))
				return fail('版本号格式非法');
			if (!validUpdateUrl(url))
				return fail('下载地址不在允许范围内（仅限 inxen/wolservice GitHub Release）');
			if (!validDigest(digest))
				return fail('缺少合法的 SHA256 摘要，拒绝安装未校验文件');
			if (!(size >= MIN_BINARY && size <= MAX_BINARY))
				return fail('文件大小超出允许范围');
			if (!ai.asset || asset != ai.asset)
				return fail('资产与当前架构不匹配');
			if (jobActive())
				return fail('已有更新任务正在进行');

			writefile(JOB_STATUS, sprintf('{"phase":"starting","message":"准备安装 %s","total":%d}\n', version, size));
			unlink(JOB_DOWNLOAD);
			spawn(`setsid sh ${sq(JOB_SCRIPT)} ${sq(url)} ${sq(digest)} ${sq(size)} ${sq(version)} ${sq(asset)} </dev/null >/dev/null 2>&1 &`);
			return { ok: true, version: version };
		}
	},

	getJob: {
		call: function() {
			let j = jobState();
			j.version = binaryInfo().version;
			j.binary_exists = exists(BIN);
			return j;
		}
	},

	serviceAction: {
		args: { action: '' },
		call: function(request) {
			let action = `${request.args.action ?? ''}`;
			let allowed = [ 'start', 'stop', 'restart', 'apply', 'sync' ];
			if (index(allowed, action) < 0)
				return fail('不支持的操作');

			if (action == 'apply') {
				let c = conf();
				let st = serviceState();
				if (!c.enabled)
					action = st.running ? 'stop' : null;
				else
					action = st.running ? 'restart' : 'start';
			}
			else if (action == 'sync') {
				let c = conf();
				let st = serviceState();
				if (c.enabled && !st.running)
					action = 'start';
				else if (!c.enabled && st.running)
					action = 'stop';
				else
					return { ok: true, action: 'noop', output: '', error: null, running: st.running, pid: st.pid };
			}

			if (action == null)
				return { ok: true, action: 'noop', output: '', error: null };

			if (action == 'restart' && !conf().enabled)
				return fail('服务未启用，请先启用服务');

			return doService(action);
		}
	},

	applySettings: {
		args: { enabled: false, config_path: '', log_max_size: 256, config_panel_enabled: '' },
		call: function(request) {
			let old = conf();
			let en = truthy(request.args.enabled);
			let cp = trim2(`${request.args.config_path ?? ''}`) || DEFAULT_CONFIG;
			let lmax = clampLog(request.args.log_max_size);
			let cpMode = `${request.args.config_panel_enabled ?? ''}`;

			if (!validConfigPath(cp))
				return fail('配置路径必须是绝对路径、不含 ..，并以 .yaml 或 .yml 结尾');

			if (cpMode == '1' || cpMode == '0') {
				let pr = setPanelEnabled(cp, cpMode == '1');
				if (pr.ok === false)
					return {
						ok: false,
						error: pr.error,
						enabled: en,
						config_path: cp,
						log_max_size: lmax,
						config_panel_enabled: cpMode == '1'
					};
			}

			let u = cursor();
			u.set(CONF, 'main', 'enabled', en ? '1' : '0');
			u.set(CONF, 'main', 'config_path', cp);
			u.set(CONF, 'main', 'log_max_size', `${lmax}`);
			u.commit(CONF);
			chmod(`/etc/config/${CONF}`, 0o600);

			shell(`/etc/init.d/wolservice ${en ? 'enable' : 'disable'} 2>&1`);

			let st = serviceState();
			let action = 'noop';
			if (en) {
				if (!st.running)
					action = 'start';
				else if (old.config_path != cp)
					action = 'restart';
			}
			else if (st.running) {
				action = 'stop';
			}

			if (action != 'noop') {
				let r = doService(action);
				if (!r.ok)
					return {
						ok: false,
						error: r.error,
						action: action,
						enabled: en,
						config_path: cp,
						log_max_size: lmax
					};
			}

			let st2 = serviceState();
			return {
				ok: true,
				action: action,
				enabled: en,
				running: st2.running,
				pid: st2.pid,
				config_path: cp,
				log_max_size: lmax,
				config_panel_enabled: cpMode == '' ? null : (cpMode == '1')
			};
		}
	},

	saveConfig: {
		args: { content: '', restart: false },
		call: function(request) {
			let content = `${request.args.content ?? ''}`;
			if (trim2(content) == '')
				return fail('配置内容不能为空');
			if (length(content) > MAX_CONFIG)
				return fail('配置内容超过 512KB');
			return writeConfigChecked(conf().config_path, content, truthy(request.args.restart));
		}
	},

	installLocal: {
		args: { path: '' },
		call: function(request) {
			let p = `${request.args.path ?? ''}`;
			if (!validBinPath(p))
				return fail('非法文件路径');
			if (!exists(p))
				return fail('文件不存在');
			if (exists(TMP_UMETA))
				return fail('已有上传任务正在进行');
			if (jobActive())
				return fail('已有更新任务正在进行');
			return doInstall(p);
		}
	},

	rollbackBinary: {
		call: function() {
			if (!exists(PREV))
				return fail('没有可回滚的版本');
			let ver = binaryVersionOf(PREV);
			if (!ver.ok)
				return fail('上一版本无法运行：' + ver.error);

			let r = shell(`cp -f ${sq(PREV)} ${sq(NEW_BIN)} && chmod 0755 ${sq(NEW_BIN)}`);
			if (r.rc != 0)
				return fail('复制上一版本失败');
			r = shell(`mv -f ${sq(NEW_BIN)} ${sq(BIN)} && chmod 0755 ${sq(BIN)}`);
			if (r.rc != 0) {
				shell(`rm -f ${sq(NEW_BIN)}`);
				return fail('替换二进制失败');
			}

			if (serviceState().running || conf().enabled) {
				let rs = doService('restart');
				if (!rs.ok)
					return { ok: false, error: '已恢复上一版本，但服务未能启动：' + (rs.error ?? ''), version: ver.version };
			}
			return { ok: true, version: ver.version };
		}
	},

	uploadBegin: {
		args: { size: 0 },
		call: function(request) {
			let size = +request.args.size;
			if (!(size >= MIN_BINARY && size <= MAX_BINARY))
				return fail('文件大小超出范围（1MB - 128MB）');
			if (jobActive())
				return fail('GitHub 更新任务正在进行，请等待完成后再上传');

			/* 浏览器关闭等原因留下旧会话时，直接丢弃并从新的会话开始。 */
			unlink(TMP_UPLOAD);
			unlink(TMP_UMETA);
			writefile(TMP_UPLOAD, '');
			writefile(TMP_UMETA, sprintf('{"size":%d,"next":0}\n', size));
			return { ok: true, total: size };
		}
	},

	uploadChunk: {
		args: { seq: 0, data: '' },
		call: function(request) {
			let meta = readJson(TMP_UMETA);
			if (meta == null)
				return fail('上传会话不存在，请重新选择文件');
			let seq = +request.args.seq;
			if (seq != meta.next)
				return fail(`分块序号不连续（期望 ${meta.next}，收到 ${seq}）`);
			let bin = b64dec(`${request.args.data ?? ''}`);
			if (bin == null || length(bin) == 0)
				return fail('无效的分块数据');

			let fd = open(TMP_UPLOAD, 'a');
			if (!fd)
				return fail('无法写入上传缓存');
			fd.write(bin);
			fd.close();

			meta.next = seq + 1;
			writefile(TMP_UMETA, sprintf('{"size":%d,"next":%d}\n', meta.size, meta.next));

			let written = fsize(TMP_UPLOAD);
			if (written > meta.size) {
				unlink(TMP_UPLOAD);
				unlink(TMP_UMETA);
				return fail('上传内容超出声明大小');
			}
			return { ok: true, written: written, total: meta.size, seq: seq };
		}
	},

	uploadEnd: {
		call: function() {
			let meta = readJson(TMP_UMETA);
			if (meta == null)
				return fail('上传会话不存在');
			let size = fsize(TMP_UPLOAD);
			if (size != meta.size) {
				unlink(TMP_UPLOAD);
				unlink(TMP_UMETA);
				return fail(`上传不完整（${size} / ${meta.size} 字节）`);
			}
			let r = doInstall(TMP_UPLOAD);
			unlink(TMP_UMETA);
			return r;
		}
	},

	uploadAbort: {
		call: function() {
			unlink(TMP_UPLOAD);
			unlink(TMP_UMETA);
			return { ok: true };
		}
	}
};

function guard(fn) {
	return function(request) {
		try {
			return fn(request);
		}
		catch (e) {
			return { ok: false, error: `内部错误：${e}` };
		}
	};
}

for (let name in methods)
	if (type(methods[name]?.call) == 'function')
		methods[name].call = guard(methods[name].call);

return { wolservice: methods };
