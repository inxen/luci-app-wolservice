function globalDefaults(exists) {
	return {
		listen: '8090',
		title: '网络唤醒',
		tls_cert: '',
		tls_key: '',
		read_timeout: '15s',
		shutdown_timeout: '15s',
		config_panel_enabled: exists ? false : true,
		auth_quick_panel: false,
		auth_config_panel: true,
		auth_trusted_enabled: false,
		auth_trusted_networks: '',
		log_level: 'info',
		log_format: 'text',
		probe_interval: '15s',
		probe_timeout: '2s'
	};
}

function stripYamlComment(value) {
	let v = trim2(value);
	if (v == '')
		return '';
	let q = substr(v, 0, 1);
	if (q == '"' || q == "'") {
		for (let i = 1; i < length(v); i++) {
			let c = substr(v, i, 1);
			if (q == '"' && c == '\\') {
				i++;
				continue;
			}
			if (c == q) {
				if (q == "'" && substr(v, i + 1, 1) == "'") {
					i++;
					continue;
				}
				return substr(v, 0, i + 1);
			}
		}
		return v;
	}
	let idx = index(v, ' #');
	if (idx >= 0)
		return trim2(substr(v, 0, idx));
	return v;
}

function unquoteYaml(value) {
	let v = trim2(value);
	if (length(v) < 2)
		return v;
	let first = substr(v, 0, 1);
	let last = substr(v, length(v) - 1, 1);
	if (first == '"' && last == '"') {
		let inner = substr(v, 1, length(v) - 2);
		inner = replace(inner, /\\\\/g, '\\');
		inner = replace(inner, /\\"/g, '"');
		inner = replace(inner, /\\n/g, '\n');
		return inner;
	}
	if (first == "'" && last == "'")
		return replace(substr(v, 1, length(v) - 2), /''/g, "'");
	return v;
}

function parseNetworkList(value) {
	let v = trim2(value ?? '');
	if (v == '')
		return [];
	let out = [];
	if (match(v, /^\[.*\]$/) != null) {
		v = trim2(substr(v, 1, length(v) - 2));
		let parts = split(v, ',');
		for (let i = 0; i < length(parts); i++) {
			let item = trim2(unquoteYaml(parts[i]));
			if (item != '')
				push(out, item);
		}
		return out;
	}
	return [ unquoteYaml(v) ];
}

function yamlBool(value) {
	return value == 'true' || value == 'yes' || value == '1';
}

function setGlobalValue(out, path, value) {
	if (path == 'server.listen')
		out.listen = value;
	else if (path == 'server.title')
		out.title = value;
	else if (path == 'server.tls_cert')
		out.tls_cert = value;
	else if (path == 'server.tls_key')
		out.tls_key = value;
	else if (path == 'server.read_timeout' && value != '')
		out.read_timeout = value;
	else if (path == 'server.shutdown_timeout' && value != '')
		out.shutdown_timeout = value;
	else if (path == 'config_panel.enabled')
		out.config_panel_enabled = yamlBool(value);
	else if (path == 'auth.quick_panel')
		out.auth_quick_panel = yamlBool(value);
	else if (path == 'auth.config_panel')
		out.auth_config_panel = yamlBool(value);
	else if (path == 'auth.trusted_networks_enabled')
		out.auth_trusted_enabled = yamlBool(value);
	else if (path == 'log.level' && value != '')
		out.log_level = value;
	else if (path == 'log.format' && value != '')
		out.log_format = value;
	else if (path == 'probe.interval' && value != '')
		out.probe_interval = value;
	else if (path == 'probe.timeout' && value != '')
		out.probe_timeout = value;
}

function parseGlobalConfig(text, exists) {
	let out = globalDefaults(exists);
	let lines = split(replace(text ?? '', /\r\n/g, '\n'), '\n');
	let section = '';
	let listNetworks = null;
	let i = 0;
	while (i < length(lines)) {
		let line = lines[i];
		if (trim2(line) == '' || match(line, /^[ \t]*#/) != null) {
			i++;
			continue;
		}
		let top = match(line, /^([A-Za-z_][A-Za-z0-9_]*):[ \t]*(.*)$/);
		if (top != null) {
			section = top[1];
			listNetworks = null;
			i++;
			continue;
		}
		let item = match(line, /^[ \t]*-[ \t]*(.*)$/);
		if (item != null) {
			if (listNetworks != null) {
				let v = trim2(unquoteYaml(stripYamlComment(item[1])));
				if (v != '')
					push(listNetworks, v);
			}
			i++;
			continue;
		}
		let kv = match(line, /^([ \t]+)([A-Za-z_][A-Za-z0-9_]*)[ \t]*:[ \t]*(.*)$/);
		if (kv == null) {
			i++;
			continue;
		}
		let key = kv[2];
		let raw = stripYamlComment(kv[3]);
		listNetworks = null;
		if (section == 'auth' && key == 'trusted_networks') {
			listNetworks = parseNetworkList(raw);
			i++;
			continue;
		}
		setGlobalValue(out, section + '.' + key, unquoteYaml(raw));
		i++;
	}
	if (listNetworks != null)
		out.auth_trusted_networks = join('\n', listNetworks);
	return out;
}

function formString(value, def, maxLen) {
	let s = value == null ? def : `${value}`;
	s = trim2(s);
	if (length(s) > maxLen || match(s, /[\r\n]/) != null)
		return null;
	return s;
}

function validDuration(value) {
	return value != '' && length(value) <= 20 && match(value, /^[0-9][0-9A-Za-z.µ]*$/) != null;
}

function stripManagedSections(text, names) {
	let lines = split(replace(text ?? '', /\r\n/g, '\n'), '\n');
	let out = [];
	let skip = false;
	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		let top = match(line, /^([A-Za-z_][A-Za-z0-9_]*):/);
		if (top != null) {
			skip = index(names, top[1]) >= 0;
			if (!skip)
				push(out, line);
			continue;
		}
		if (!skip)
			push(out, line);
	}
	return join('\n', out);
}

function buildGlobalConfig(text, f, exists) {
	let port = +f.listen_port;
	if (!(port >= 1 && port <= 65535))
		return fail('监听端口必须是 1-65535');
	let host = formString(f.listen_host, '', 100);
	if (host == null)
		return fail('绑定地址过长或包含换行');
	if (host != '') {
		if (match(host, /^[A-Za-z0-9._:\[\]-]+$/) == null)
			return fail('绑定地址格式非法');
		if (host == '0.0.0.0' || host == '::' || host == '[::]')
			host = '';
	}
	let listen = `${port}`;
	if (host != '') {
		let h = replace(host, /^\[/, '');
		h = replace(h, /\]$/, '');
		listen = (index(h, ':') >= 0 ? '[' + h + ']' : h) + ':' + port;
	}

	let title = formString(f.title, '网络唤醒', 200);
	if (title == null)
		return fail('标题过长或包含换行');
	if (title == '')
		title = '网络唤醒';

	let tlsCert = formString(f.tls_cert, '', 500);
	let tlsKey = formString(f.tls_key, '', 500);
	if (tlsCert == null || tlsKey == null)
		return fail('TLS 证书/私钥路径过长或包含换行');
	if ((tlsCert == '') != (tlsKey == ''))
		return fail('TLS 证书和私钥必须同时填写或同时留空');

	let readTimeout = formString(f.read_timeout, '15s', 20);
	let shutdownTimeout = formString(f.shutdown_timeout, '15s', 20);
	let probeInterval = formString(f.probe_interval, '15s', 20);
	let probeTimeout = formString(f.probe_timeout, '2s', 20);
	if (!validDuration(readTimeout))
		return fail('读取超时格式无效（如 15s、500ms、1m30s）');
	if (!validDuration(shutdownTimeout))
		return fail('关闭超时格式无效（如 15s、500ms、1m30s）');
	if (!validDuration(probeInterval))
		return fail('探测间隔格式无效（如 15s、500ms、1m30s）');
	if (!validDuration(probeTimeout))
		return fail('探测超时格式无效（如 15s、500ms、1m30s）');

	let level = `${f.log_level ?? 'info'}`;
	let format = `${f.log_format ?? 'text'}`;
	if (index([ 'debug', 'info', 'warn', 'error' ], level) < 0)
		return fail('日志级别必须是 debug/info/warn/error');
	if (index([ 'text', 'json' ], format) < 0)
		return fail('日志格式必须是 text/json');

	let networks = [];
	let netLines = split(replace(`${f.auth_trusted_networks ?? ''}`, /\r\n/g, '\n'), '\n');
	for (let i = 0; i < length(netLines); i++) {
		let v = trim2(netLines[i]);
		if (v == '' || substr(v, 0, 1) == '#')
			continue;
		if (match(v, /^[0-9A-Fa-f:.]+(\/[0-9]{1,3})?$/) == null)
			return fail('可信网段格式无效：' + v);
		push(networks, v);
	}
	if (truthy(f.auth_trusted_enabled) && length(networks) == 0)
		return fail('启用可信网段时必须至少填写一个地址或 CIDR');

	let q = function(s) { return sprintf('%J', s); };
	let content = '';
	content += 'server:\n';
	content += '  listen: ' + q(listen) + '\n';
	content += '  title: ' + q(title) + '\n';
	content += '  tls_cert: ' + q(tlsCert) + '\n';
	content += '  tls_key: ' + q(tlsKey) + '\n';
	content += '  read_timeout: ' + q(readTimeout) + '\n';
	content += '  shutdown_timeout: ' + q(shutdownTimeout) + '\n';
	content += 'config_panel:\n';
	content += '  enabled: ' + (truthy(f.config_panel_enabled) ? 'true' : 'false') + '\n';
	content += 'log:\n';
	content += '  level: ' + q(level) + '\n';
	content += '  format: ' + q(format) + '\n';
	content += 'probe:\n';
	content += '  interval: ' + q(probeInterval) + '\n';
	content += '  timeout: ' + q(probeTimeout) + '\n';
	content += 'auth:\n';
	content += '  quick_panel: ' + (truthy(f.auth_quick_panel) ? 'true' : 'false') + '\n';
	content += '  config_panel: ' + (truthy(f.auth_config_panel) ? 'true' : 'false') + '\n';
	content += '  trusted_networks_enabled: ' + (truthy(f.auth_trusted_enabled) ? 'true' : 'false') + '\n';
	if (length(networks) == 0) {
		content += '  trusted_networks: []\n';
	}
	else {
		let items = [];
		for (let i = 0; i < length(networks); i++)
			push(items, q(networks[i]));
		content += '  trusted_networks: [' + join(', ', items) + ']\n';
	}

	let rest = trim2(stripManagedSections(text, [ 'server', 'config_panel', 'log', 'probe', 'auth', 'relay' ]));
	let final = (rest != '' ? rest + '\n\n' : '') + content;
	return { ok: true, content: final };
}

