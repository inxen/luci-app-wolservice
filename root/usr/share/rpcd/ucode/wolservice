#!/usr/bin/ucode
// SPDX-License-Identifier: MIT
//
// luci-app-wolservice —— rpcd ucode 插件
//
// 职责：UCI 设置、procd 状态、日志、配置校验/保存、二进制上传/安装/回滚。
// 安全要点：
//   * 主配置只读取/写入 YAML；凭据在加密 secrets 文件中，本插件不读取其内容。
//   * 日志返回前对 password/token/secret 等键值做脱敏。
//   * 所有外部命令参数都经过路径/字符白名单与 shell 单引号转义。
//   * 二进制先写入临时文件并执行 -version 验证，成功后原子替换；失败自动回滚。

'use strict';

import { popen, readfile, writefile, open, stat, access, unlink, chmod } from 'fs';
import { cursor } from 'uci';

const CONF = 'wolservice';
const BIN = '/usr/bin/wol';
const PREV = '/usr/bin/wol.prev';
const NEW_BIN = '/usr/bin/.wol.new';
const LOG_FILE = '/tmp/log/wolservice.log';
const DEFAULT_CONFIG = '/etc/wol/wol.yaml';
const TMP_UPLOAD = '/tmp/wolservice.upload';
const TMP_UMETA = '/tmp/wolservice.upload.meta';
const JOB_SCRIPT = '/usr/libexec/wolservice/install-job.sh';
const JOB_STATUS = '/tmp/wolservice.install.status';
const JOB_DOWNLOAD = '/tmp/wolservice.download';
const GH_API = 'https://api.github.com/repos/inxen/wolservice/releases/latest';
const GH_DL_PREFIX = 'https://github.com/inxen/wolservice/releases/download/';
const MIN_BINARY = 1024 * 1024;
const MAX_BINARY = 128 * 1024 * 1024;
const MAX_CONFIG = 512 * 1024;

/* ---------------- 基础工具 ---------------- */

function fail(msg) {
	return { ok: false, error: `${msg}` };
}

function sq(s) {
	return `'${replace(`${s}`, /'/g, `'\\''`)}'`;
}

function trim2(s) {
	return s == null ? '' : replace(`${s}`, /^[ \t\r\n]+|[ \t\r\n]+$/g, '');
}

function shell(cmd) {
	let p = popen(`${cmd}; echo "__RC__=$?"`);
	if (!p)
		return { rc: -1, out: '' };
	let out = p.read('all') ?? '';
	p.close();
	let m = match(out, /__RC__=(-?\d+)\s*$/);
	let rc = m ? +m[1] : -1;
	if (m)
		out = replace(out, /__RC__=-?\d+\s*$/, '');
	return { rc, out };
}

function exists(path) {
	return access(path) ? true : false;
}

function spawn(cmd) {
	let p = popen(cmd);
	if (!p)
		return false;
	p.read('all');
	p.close();
	return true;
}

function fsize(path) {
	try {
		let s = stat(path);
		return s ? s.size : -1;
	} catch (e) {
		return -1;
	}
}

function fmtime(path) {
	try {
		let s = stat(path);
		return s ? (s.mtime ?? null) : null;
	} catch (e) {
		return null;
	}
}

function lastLine(text) {
	let lines = split(text ?? '', '\n');
	for (let i = length(lines) - 1; i >= 0; i--)
		if (trim2(lines[i]) != '')
			return lines[i];
	return '';
}

function readJson(path) {
	try {
		let raw = readfile(path);
		return raw ? json(raw) : null;
	} catch (e) {
		return null;
	}
}

function dirOf(p) {
	let idx = -1;
	for (let i = 0; i < length(p); i++)
		if (substr(p, i, 1) == '/')
			idx = i;
	return idx > 0 ? substr(p, 0, idx) : '/';
}

function baseNoExt(p) {
	let slash = -1, dot = -1;
	for (let i = 0; i < length(p); i++) {
		let ch = substr(p, i, 1);
		if (ch == '/')
			slash = i;
		else if (ch == '.')
			dot = i;
	}
	return dot > slash ? substr(p, 0, dot) : p;
}

function secretsPath(configPath) {
	return baseNoExt(configPath) + '.secrets.yaml';
}

function secretsKeyPath(secrets) {
	return baseNoExt(secrets) + '.key';
}

function truthy(v) {
	return v === true || `${v}` == '1' || `${v}` == 'true';
}

/* ---------------- 配置与路径 ---------------- */

function clampLog(v) {
	let n = +v;
	if (!(n >= 32))
		n = 256;
	if (n > 8192)
		n = 8192;
	return n;
}

function validConfigPath(p) {
	if (p == null || p == '' || length(p) > 200)
		return false;
	if (match(p, /^\/[A-Za-z0-9._\/-]+$/) == null)
		return false;
	if (match(p, /\.\./) != null)
		return false;
	if (match(p, /\.(yaml|yml)$/) == null)
		return false;
	return true;
}

function validBinPath(p) {
	return match(p ?? '', /^\/tmp\/[A-Za-z0-9._-]+$/) != null;
}

function conf() {
	let u = cursor();
	let g = function(k) { return u.get(CONF, 'main', k); };
	let cp = trim2(g('config_path') ?? '') || DEFAULT_CONFIG;
	if (!validConfigPath(cp))
		cp = DEFAULT_CONFIG;
	return {
		enabled: g('enabled') == '1',
		config_path: cp,
		log_max_size: clampLog(g('log_max_size'))
	};
}

function setUciEnabled(v) {
	let u = cursor();
	u.set(CONF, 'main', 'enabled', v ? '1' : '0');
	u.commit(CONF);
	chmod(`/etc/config/${CONF}`, 0o600);
}

/* 只做 YAML 顶层字段的轻量解析：listen/title/tls/config_panel。 */
function parseConfig(text) {
	let out = {
		listen: '',
		title: '',
		tls: false,
		tls_cert: '',
		tls_key: '',
		read_timeout: '15s',
		shutdown_timeout: '15s',
		panel: false,
		log_level: 'info',
		log_format: 'text'
	};
	let section = '';
	let lines = split(text ?? '', '\n');
	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		if (trim2(line) == '' || match(line, /^[ \t]*#/) != null)
			continue;
		let top = match(line, /^([A-Za-z_][A-Za-z0-9_]*):[ \t]*(.*)$/);
		if (top != null) {
			section = top[1];
			continue;
		}
		let kv = match(line, /^[ \t]+([A-Za-z_][A-Za-z0-9_]*):[ \t]*(.*)$/);
		if (kv == null)
			continue;
		let key = kv[1];
		let val = replace(kv[2], /[ \t]+#.*$/, '');
		val = replace(val, /^["']/, '');
		val = replace(val, /["'][ \t]*$/, '');
		if (section == 'server') {
			if (key == 'listen')
				out.listen = trim2(val);
			else if (key == 'title')
				out.title = val;
			else if (key == 'tls_cert') {
				out.tls_cert = trim2(val);
				out.tls = out.tls_cert != '';
			}
			else if (key == 'tls_key')
				out.tls_key = trim2(val);
			else if (key == 'read_timeout' && trim2(val) != '')
				out.read_timeout = trim2(val);
			else if (key == 'shutdown_timeout' && trim2(val) != '')
				out.shutdown_timeout = trim2(val);
		}
		else if (section == 'config_panel' && key == 'enabled') {
			out.panel = (val == 'true' || val == 'yes' || val == '1');
		}
		else if (section == 'log') {
			if (key == 'level' && trim2(val) != '')
				out.log_level = trim2(val);
			else if (key == 'format' && trim2(val) != '')
				out.log_format = trim2(val);
		}
	}
	return out;
}

function splitListen(listen) {
	let l = trim2(listen);
	if (l == '')
		return null;
	let m = match(l, /^([0-9]+)$/);
	if (m != null) {
		let p = +m[1];
		return (p > 0 && p < 65536) ? { host: '', port: p } : null;
	}
	m = match(l, /^\[([^\]]*)\]:([0-9]+)$/);
	if (m != null) {
		let p = +m[2];
		return (p > 0 && p < 65536) ? { host: m[1], port: p } : null;
	}
	m = match(l, /^([^:]*):([0-9]+)$/);
	if (m != null) {
		let p = +m[2];
		return (p > 0 && p < 65536) ? { host: trim2(m[1]), port: p } : null;
	}
	return null;
}

function hasLegacySecrets(text) {
	let lines = split(text ?? '', '\n');
	for (let i = 0; i < length(lines); i++) {
		if (match(lines[i], /^[ \t]*(access_token|password|token|secret_key|auth_key|private_key|passphrase)[ \t]*:[ \t]*[^ \t#]+/) != null)
			return true;
	}
	return false;
}

/* ---------------- 运行时状态 ---------------- */

function serviceState() {
	let r = shell(`ubus call service list '{"name":"wolservice"}'`);
	if (r.rc != 0)
		return { running: false, pid: null };
	let j = null;
	try { j = json(r.out); } catch (e) { j = null; }
	let svc = j ? j['wolservice'] : null;
	if (svc && svc.instances) {
		let main = svc.instances['main'];
		if (main)
			return { running: main.running === true, pid: main.pid ?? null };
		let first = null;
		for (let k in svc.instances) {
			let inst = svc.instances[k];
			let cur = { running: inst.running === true, pid: inst.pid ?? null };
			if (first == null)
				first = cur;
			if (cur.running)
				return cur;
		}
		if (first != null)
			return first;
	}
	return { running: false, pid: null };
}

function binaryInfo() {
	let out = {
		exists: exists(BIN),
		size: fsize(BIN),
		version: null,
		error: null,
		mtime: fmtime(BIN)
	};
	if (!out.exists)
		return out;
	let r = shell(`${BIN} -version 2>&1`);
	if (r.rc == 0 && trim2(r.out) != '')
		out.version = trim2(r.out);
	else
		out.error = trim2(r.out) || ('rc=' + r.rc);
	return out;
}

function binaryVersionOf(path) {
	let r = shell(`${sq(path)} -version 2>&1`);
	let out = trim2(r.out);
	if (r.rc != 0)
		return { ok: false, version: null, error: out || ('rc=' + r.rc) };
	return { ok: true, version: out, error: null };
}

function checkConfig(cp) {
	let sp = secretsPath(cp), kp = secretsKeyPath(sp);
	let res = {
		path: cp,
		exists: exists(cp),
		size: fsize(cp),
		mtime: fmtime(cp),
		ok: false,
		devices: null,
		error: null,
		output: '',
		listen: '',
		title: '',
		tls: false,
		panel: false,
		legacy_secrets: false,
		secrets_exists: exists(sp),
		secrets_key_exists: exists(kp)
	};
	if (!res.exists) {
		res.error = '配置文件不存在';
		return res;
	}
	let text = '';
	try { text = readfile(cp) ?? ''; } catch (e) { text = ''; }
	if (fsize(cp) > 2 * 1024 * 1024) {
		res.error = '配置文件过大';
		return res;
	}
	let p = parseConfig(text);
	res.listen = p.listen;
	res.title = p.title;
	res.tls = p.tls;
	res.panel = p.panel;
	res.legacy_secrets = hasLegacySecrets(text);

	if (!exists(BIN)) {
		res.error = '未安装二进制，无法校验配置';
		return res;
	}

	let r = shell(`${BIN} -config ${sq(cp)} -secrets ${sq(sp)} -secrets-key ${sq(kp)} -check 2>&1`);
	res.output = trim2(r.out);
	if (r.rc == 0) {
		res.ok = true;
		let m = match(res.output, /\((\d+) devices?\)/);
		res.devices = m ? +m[1] : 0;
	}
	else {
		res.error = lastLine(res.output) || '配置校验失败';
	}
	return res;
}

function maskSensitive(line) {
	line = replace(line, /"(password|passphrase|token|access_token|secret_key|auth_key|private_key|bemfa_secret_key|blinker_auth_key)"[ \t]*:[ \t]*"[^"]*"/g, '"***":"***"');
	line = replace(line, /password=[^ \t\r\n]+/g, 'password=***');
	line = replace(line, /passphrase=[^ \t\r\n]+/g, 'passphrase=***');
	line = replace(line, /token=[^ \t\r\n]+/g, 'token=***');
	line = replace(line, /access_token=[^ \t\r\n]+/g, 'access_token=***');
	line = replace(line, /secret_key=[^ \t\r\n]+/g, 'secret_key=***');
	line = replace(line, /auth_key=[^ \t\r\n]+/g, 'auth_key=***');
	line = replace(line, /private_key=[^ \t\r\n]+/g, 'private_key=***');
	return line;
}

function logLines(n) {
	let r = shell(`tail -n ${n} ${sq(LOG_FILE)} 2>/dev/null`);
	let txt = trim2(r.out);
	if (txt != '') {
		let raw = split(txt, '\n');
		let out = [];
		for (let i = 0; i < length(raw); i++)
			if (trim2(raw[i]) != '')
				push(out, raw[i]);
		return out;
	}
	r = shell('logread -e wolservice 2>/dev/null');
	txt = trim2(r.out);
	if (txt == '')
		return [];
	return split(txt, '\n');
}

function sanitize(lines) {
	let out = [];
	for (let i = 0; i < length(lines); i++)
		push(out, maskSensitive(lines[i]));
	return out;
}

function sanitizeText(text) {
	let lines = split(text ?? '', '\n');
	let out = [];
	for (let i = 0; i < length(lines); i++)
		push(out, maskSensitive(lines[i]));
	return join('\n', out);
}

/* 构建方式建议不是运行时故障，安全提示里会单独说明，不占“最近告警/错误” */
function isBuildAdvisory(line) {
	return match(line, /secrets master key is stored on disk/) != null;
}

function lastErrorOf(lines) {
	for (let i = length(lines) - 1; i >= 0; i--) {
		if (isBuildAdvisory(lines[i]))
			continue;
		if (match(lines[i], /level=(ERROR|WARN)/) != null)
			return lines[i];
	}
	return null;
}

/* ---------------- 服务自带面板探测 ---------------- */

function httpGet(url, insecure, timeout) {
	let t = timeout ?? 3;
	let opt = insecure ? ' -k' : '';
	if (exists('/usr/bin/curl'))
		return shell(`curl -fsS --max-time ${t}${opt} ${sq(url)} 2>&1`);
	let uopt = insecure ? ' --no-check-certificate' : '';
	return shell(`uclient-fetch -q -O - --timeout=${t}${uopt} ${sq(url)} 2>&1`);
}

function panelProbe(cc) {
	let sl = splitListen(cc.listen);
	if (sl == null)
		return { ok: false, error: '无法解析 server.listen', url: null, info: null };
	let host = (sl.host != '' && sl.host != '0.0.0.0' && sl.host != '::') ? sl.host : '127.0.0.1';
	if (index(host, ':') >= 0 && substr(host, 0, 1) != '[')
		host = `[${host}]`;
	let scheme = cc.tls ? 'https' : 'http';
	let url = `${scheme}://${host}:${sl.port}/api/info`;
	let r = httpGet(url, cc.tls);
	let info = null;
	try { info = json(trim2(r.out)); } catch (e) { info = null; }
	if (info == null)
		return {
			ok: false,
			url: url,
			info: null,
			error: trim2(r.out) || ('请求失败 rc=' + r.rc)
		};
	return { ok: true, url: url, info: info, error: null };
}

/* ---------------- 服务动作 ---------------- */

function doService(action) {
	let c = conf();
	let init = '/etc/init.d/wolservice';

	if ((action == 'start' || action == 'restart') && !exists(BIN))
		return fail('未安装 /usr/bin/wol，请先在页面中上传二进制');

	if (action == 'start') {
		setUciEnabled(true);
		shell(`${init} enable 2>&1`);
	}
	else if (action == 'stop') {
		setUciEnabled(false);
		shell(`${init} disable 2>&1`);
	}

	let r = shell(`${init} ${action} 2>&1`);
	let out = trim2(r.out);
	let st = serviceState();

	if (action == 'start' || action == 'restart') {
		for (let i = 0; i < 6 && !st.running; i++) {
			shell('sleep 1');
			st = serviceState();
		}
	}
	else if (action == 'stop') {
		for (let i = 0; i < 3 && st.running; i++) {
			shell('sleep 1');
			st = serviceState();
		}
	}

	let ok;
	if (action == 'stop')
		ok = !st.running;
	else if (action == 'start' || action == 'restart')
		ok = st.running;
	else
		ok = r.rc == 0;

	let error = null;
	if (!ok) {
		let tail = sanitize(logLines(8));
		if (out != '')
			error = sanitizeText(out);
		else if (action == 'start' || action == 'restart')
			error = '服务未能启动，原因见日志：\n' + tail.join('\n');
		else
			error = '操作未生效（详见日志）';
	}

	return { ok: ok, action: action, output: sanitizeText(out), error: error, running: st.running, pid: st.pid };
}

/* ---------------- 二进制安装 ---------------- */

function doInstall(src) {
	let size = fsize(src);
	if (size < MIN_BINARY)
		return fail('文件过小（至少 1MB），不是有效的 WOL 二进制');
	if (size > MAX_BINARY)
		return fail('文件过大（上限 128MB）');

	let magic = shell(`head -c 4 ${sq(src)} | hexdump -v -e '1/1 "%02x"'`);
	if (trim2(magic.out) != '7f454c46') {
		unlink(src);
		return fail('不是 ELF 可执行文件');
	}

	let r = shell(`cp -f ${sq(src)} ${sq(NEW_BIN)} && chmod 0755 ${sq(NEW_BIN)}`);
	if (r.rc != 0) {
		unlink(src);
		return fail('写入临时二进制失败');
	}

	let ver = binaryVersionOf(NEW_BIN);
	if (!ver.ok) {
		shell(`rm -f ${sq(NEW_BIN)}`);
		unlink(src);
		return fail('二进制无法在当前系统运行（架构不匹配或文件损坏）：' + ver.error);
	}

	if (exists(BIN))
		shell(`cp -f ${sq(BIN)} ${sq(PREV)} && chmod 0755 ${sq(PREV)} 2>/dev/null`);

	r = shell(`mv -f ${sq(NEW_BIN)} ${sq(BIN)} && chmod 0755 ${sq(BIN)}`);
	if (r.rc != 0) {
		unlink(src);
		return fail('替换二进制失败');
	}
	unlink(src);

	let wasRunning = serviceState().running;
	if (wasRunning || conf().enabled) {
		let rs = doService('restart');
		if (!rs.ok) {
			if (exists(PREV)) {
				shell(`cp -f ${sq(PREV)} ${sq(BIN)} && chmod 0755 ${sq(BIN)}`);
				doService('restart');
				return {
					ok: false,
					error: '新二进制启动失败，已回滚到上一版本（若仍失败请查看日志，可能是配置问题）：' + (rs.error ?? ''),
					version: ver.version,
					rolled_back: true
				};
			}
			return { ok: false, error: '新二进制启动失败：' + (rs.error ?? ''), version: ver.version };
		}
	}

	return { ok: true, version: ver.version, size: size };
}

/* ---------------- 配置写入 ---------------- */

/* 只修改顶层 section 下的一行布尔值；返回 null 表示该 section 不是块格式。 */
function setYamlSectionBool(text, section, key, value) {
	let normalized = replace(text ?? '', /\r\n/g, '\n');
	let lines = split(normalized, '\n');
	let sectionIdx = -1;
	let keyIdx = -1;
	let keyIndent = '';
	let inSection = false;

	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		if (trim2(line) == '' || match(line, /^[ \t]*#/) != null)
			continue;

		let top = match(line, /^([A-Za-z_][A-Za-z0-9_]*):[ \t]*(.*)$/);
		if (top != null) {
			inSection = false;
			if (top[1] == section) {
				let tail = trim2(top[2]);
				if (tail != '' && match(tail, /^#/) == null)
					return null;
				sectionIdx = i;
				inSection = true;
			}
			continue;
		}

		if (!inSection)
			continue;

		let kv = match(line, /^([ \t]+)([A-Za-z_][A-Za-z0-9_]*)[ \t]*:[ \t]*(.*)$/);
		if (kv != null && kv[2] == key) {
			keyIdx = i;
			keyIndent = kv[1];
			break;
		}
	}

	if (keyIdx >= 0) {
		lines[keyIdx] = keyIndent + key + ': ' + value;
		return join('\n', lines);
	}

	if (sectionIdx >= 0) {
		let indent = '';
		for (let j = sectionIdx + 1; j < length(lines); j++) {
			if (trim2(lines[j]) == '' || match(lines[j], /^[ \t]*#/) != null)
				continue;
			let m = match(lines[j], /^([ \t]+)/);
			if (m != null)
				indent = m[1];
			break;
		}
		if (indent == '')
			indent = '  ';
		let insert = indent + key + ': ' + value;
		let before = slice(lines, 0, sectionIdx + 1);
		let after = slice(lines, sectionIdx + 1);
		if (length(after) == 0)
			return join('\n', before) + '\n' + insert + '\n';
		return join('\n', before) + '\n' + insert + '\n' + join('\n', after);
	}

	let base = normalized;
	if (base != '' && substr(base, length(base) - 1, 1) != '\n')
		base += '\n';
	return base + '\n' + section + ':\n  ' + key + ': ' + value + '\n';
}

/* 校验并原子写入配置；被 YAML 编辑器和配置中心开关共用。 */
function writeConfigChecked(cp, content, restart) {
	let dir = dirOf(cp);
	shell(`mkdir -p ${sq(dir)} 2>/dev/null && chmod 700 ${sq(dir)} 2>/dev/null`);

	let tmp = cp + '.luci-new';
	writefile(tmp, content);
	chmod(tmp, 0o600);
	if (fsize(tmp) <= 0) {
		unlink(tmp);
		return fail('写入临时配置失败');
	}
	if (fsize(tmp) > MAX_CONFIG) {
		unlink(tmp);
		return fail('配置内容超过 512KB');
	}

	let sp = secretsPath(cp), kp = secretsKeyPath(sp);
	let r = shell(`${BIN} -config ${sq(tmp)} -secrets ${sq(sp)} -secrets-key ${sq(kp)} -check 2>&1`);
	if (r.rc != 0) {
		unlink(tmp);
		return {
			ok: false,
			saved: false,
			error: lastLine(trim2(r.out)) || '配置校验失败',
			output: trim2(r.out)
		};
	}

	let oldText = exists(cp) ? (readfile(cp) ?? '') : '';
	let oldP = parseConfig(oldText);
	let newP = parseConfig(content);
	let needsRestart = oldP.listen != newP.listen || oldP.tls != newP.tls ||
		oldP.read_timeout != newP.read_timeout || oldP.shutdown_timeout != newP.shutdown_timeout ||
		oldP.log_level != newP.log_level || oldP.log_format != newP.log_format;

	if (exists(cp))
		shell(`cp -f ${sq(cp)} ${sq(cp + '.luci-bak')} 2>/dev/null && chmod 600 ${sq(cp + '.luci-bak')} 2>/dev/null`);

	let mv = shell(`mv -f ${sq(tmp)} ${sq(cp)} 2>&1`);
	if (mv.rc != 0) {
		unlink(tmp);
		return fail('写入配置失败：' + trim2(mv.out));
	}
	chmod(cp, 0o600);

	let restarted = false, restartError = null;
	if (restart && conf().enabled) {
		let rr = doService('restart');
		restarted = rr.ok;
		if (!rr.ok)
			restartError = rr.error;
	}

	return {
		ok: restartError == null,
		saved: true,
		needs_restart: needsRestart && !restarted,
		restarted: restarted,
		error: restartError ?? (needsRestart && !restarted ? '监听/TLS/超时/日志级别等变更需要重启服务后才能生效' : null),
		output: trim2(r.out)
	};
}

function setPanelEnabled(cp, value) {
	if (!exists(cp)) {
		if (value)
			return { ok: true, changed: false, saved: false, output: '' };
		return fail('配置文件不存在，请先启动服务生成默认配置，再关闭配置中心');
	}
	let text = '';
	try { text = readfile(cp) ?? ''; } catch (e) { return fail('读取配置文件失败：' + e); }
	let updated = setYamlSectionBool(text, 'config_panel', 'enabled', value ? 'true' : 'false');
	if (updated == null)
		return fail('config_panel 使用了非块格式，无法自动修改；请用 YAML 编辑器修改');
	if (updated == text)
		return { ok: true, changed: false, saved: false, output: '' };

	let r = writeConfigChecked(cp, updated, false);
	if (r.ok === false)
		return r;
	r.changed = true;
	return r;
}

